---
import Base from './Base.astro';
import Header from '@/components/header/Header.astro';
import Footer from '@/components/footer/Footer.astro';
import NewsletterBand from '@/components/marketing/NewsletterBand.astro';
import ArticleScrollDepth from '@/components/analytics/ArticleScrollDepth.astro';
import { generatePageMetadata, type PageMetadata } from '@/lib/metadata';

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  type?: 'website' | 'article';
  overlay?: boolean;
  showFooter?: boolean;
  /**
   * Pre-footer `#stay` newsletter band. Defaults on for marketing pages. Blog
   * routes pass `false` so journal subscribe modules do not stack a second band.
   * Hidden with the footer on the 404 page.
   */
  showNewsletter?: boolean;
  metadata?: PageMetadata;
}

const {
  title,
  description,
  path,
  image,
  type = 'website',
  overlay = false,
  showFooter = true,
  showNewsletter = true,
  metadata: metadataOverride,
} = Astro.props;

const metadata =
  metadataOverride ??
  generatePageMetadata({
    title,
    description,
    path,
    image,
    type,
  });
---

<Base metadata={metadata}>
  <Header overlay={overlay} currentPath={Astro.url.pathname} />
  <main class="flex-1">
    <slot />
  </main>
  {showFooter && showNewsletter && <NewsletterBand />}
  {showFooter && <Footer />}
  <ArticleScrollDepth />
</Base>
