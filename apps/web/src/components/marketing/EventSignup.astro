---
/**
 * On-site event signup form (static). Posts to /api/events/signup/ with the same fields as
 * the React EventSignup (eventId, name, email, website honeypot). When the event is full,
 * shows the waitlist state instead. Phase 4 hydrates via data-form="event-signup".
 */
import Button from '@/components/ui/Button.astro';
import { cn } from '@/lib/cn';
import SubscribePrivacyNote from './SubscribePrivacyNote.astro';
import { INPUT_CLASS, LABEL_CLASS, REQUIRED_MARK_CLASS } from './form-classes';

interface Props {
  eventId: string;
  eventTitle: string;
  isFull?: boolean;
  class?: string;
}

const { eventId, eventTitle, isFull = false, class: className } = Astro.props;
---

{isFull ? (
  <div class={cn('mt-6 border-t border-line pt-5', className)} aria-live="polite">
    <p class="text-[14.5px] leading-[1.55] text-charcoal">
      This event is full. Join the waitlist by subscribing — we'll invite you when a spot opens or
      the next day is announced.
    </p>
    <div class="mt-4">
      <Button href="/subscribe/" variant="outline" size="sm">
        Full — join the waitlist
      </Button>
    </div>
  </div>
) : (
  <div class={cn('mt-6 border-t border-line pt-5', className)}>
    <p class="text-[13px] font-semibold text-bark">Sign up for this event</p>
    <form
      method="post"
      action="/api/events/signup/"
      data-form="event-signup"
      data-event-title={eventTitle}
      class="mt-3"
      novalidate
    >
      <input type="hidden" name="eventId" value={eventId} />
      <div aria-hidden="true" style="display: none">
        <label for={`event-signup-website-${eventId}`}>Website</label>
        <input
          type="text"
          name="website"
          id={`event-signup-website-${eventId}`}
          tabindex="-1"
          autocomplete="off"
        />
      </div>

      <div class="flex flex-col gap-3">
        <div class="space-y-2">
          <label for={`event-signup-name-${eventId}`} class={LABEL_CLASS}>
            Name<span class={REQUIRED_MARK_CLASS}>*</span>
          </label>
          <input
            type="text"
            id={`event-signup-name-${eventId}`}
            name="name"
            required
            autocomplete="name"
            class={INPUT_CLASS}
          />
        </div>

        <div class="space-y-2">
          <label for={`event-signup-email-${eventId}`} class={LABEL_CLASS}>
            Email<span class={REQUIRED_MARK_CLASS}>*</span>
          </label>
          <input
            type="email"
            id={`event-signup-email-${eventId}`}
            name="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
            class={INPUT_CLASS}
          />
        </div>

        <SubscribePrivacyNote class="mt-1" />

        <Button type="submit" variant="bracken" size="sm" class="self-start">
          Sign up
        </Button>
      </div>
    </form>
  </div>
)}
