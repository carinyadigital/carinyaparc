---
/** Titled grid of recipe cards (ported from features/recipes/RecipeGrid). */
import type { RecipeSummary } from '@/lib/content/recipes';
import RecipeCard from './RecipeCard.astro';

interface Props {
  title: string;
  subtitle: string;
  recipes: RecipeSummary[];
}

const { title, subtitle, recipes } = Astro.props;
---

<div class="mx-auto max-w-7xl px-6 lg:px-8">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-4xl font-semibold tracking-tight text-balance text-eucalypt-600 sm:text-5xl">
      {title}
    </h2>
    <p class="mt-2 text-lg/8 text-eucalypt-300">{subtitle}</p>
  </div>

  {recipes.length > 0 ? (
    <div class="mx-auto mt-16 grid max-w-2xl auto-rows-fr grid-cols-1 gap-8 sm:mt-20 lg:mx-0 lg:max-w-none lg:grid-cols-3">
      {recipes.map((recipe, index) => (
        <RecipeCard recipe={recipe} index={index} />
      ))}
    </div>
  ) : (
    <p class="mt-16 text-center text-lg text-stone">
      Recipes from the hearth are on their way — check back soon.
    </p>
  )}
</div>
