---
/** Blog post card. `journal` = whole card is the link; `default` = title link with stretched hit area. */
import { Image } from 'astro:assets';

import { cn } from '@/lib/cn';
import { tagName, type PostSummary } from '@/lib/content/posts';
import { imagePresets } from '@/lib/images';

interface Props {
  post: PostSummary;
  variant?: 'default' | 'journal' | 'related';
  /** Hero images above the fold on listing pages should load eagerly. */
  eager?: boolean;
}

const { post, variant = 'default', eager = false } = Astro.props;
const category = post.categoryName ?? (post.tags[0] ? tagName(post.tags[0]) : 'Journal');
const isJournal = variant === 'journal';
const Wrapper = isJournal ? 'a' : 'article';
const wrapperProps = isJournal ? { href: post.href } : {};
---

<Wrapper
  {...wrapperProps}
  class={cn(
    'group relative flex flex-col overflow-hidden rounded-lg border border-line shadow-md transition-all duration-150 hover:-translate-y-1 hover:shadow-lg',
    isJournal ? 'bg-white' : 'bg-paperbark',
  )}
>
  <div class="relative aspect-[16/10] overflow-hidden">
    {post.image ? (
      <Image
        src={post.image}
        alt={post.imageAlt}
        widths={imagePresets.card.widths}
        sizes={imagePresets.card.sizes}
        quality={imagePresets.card.quality}
        format={imagePresets.card.format}
        loading={eager ? 'eager' : 'lazy'}
        class={cn(
          'h-full w-full object-cover',
          isJournal && 'transition-transform duration-300 group-hover:scale-[1.02]',
        )}
      />
    ) : (
      <img src="/images/placeholder.svg" alt="" class="h-full w-full object-cover" loading="lazy" />
    )}
  </div>
  <div class="flex flex-1 flex-col p-[26px]">
    <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-bracken-500">{category}</p>
    <h3
      class={cn(
        'font-heading text-[22px] font-normal leading-[1.22] text-bark',
        isJournal ? 'mt-2.5' : 'mt-2',
      )}
    >
      {isJournal ? (
        post.title
      ) : (
        <a href={post.href} class="transition-opacity hover:opacity-70">
          <span class="absolute inset-0" aria-hidden="true" />
          {post.title}
        </a>
      )}
    </h3>
    <p class="mt-2.5 line-clamp-2 text-[14.5px] leading-[1.55] text-stone">
      {isJournal ? post.excerpt : post.description}
    </p>
    <p class="mt-4 text-[13px] text-stone">{isJournal ? post.meta : post.formattedDate}</p>
  </div>
</Wrapper>
