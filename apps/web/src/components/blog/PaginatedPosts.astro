---
/** One page of the journal grid (three-up PostCards) plus the page navigation. */
import type { PostSummary } from '@/lib/content/posts';

import PaginationNav from './PaginationNav.astro';
import PostCard from './PostCard.astro';

interface Props {
  posts: PostSummary[];
  page: number;
  totalPages: number;
}

const { posts, page, totalPages } = Astro.props;
---

<div class="mx-auto max-w-[1240px] px-6 lg:px-14">
  {posts.length > 0 ? (
    <>
      <div class="grid auto-rows-fr grid-cols-1 gap-[30px] lg:grid-cols-3">
        {posts.map((post) => (
          <PostCard post={post} variant="journal" />
        ))}
      </div>
      <PaginationNav currentPage={page} totalPages={totalPages} />
    </>
  ) : (
    <p class="py-12 text-center text-charcoal">
      No posts in this category yet. Try another filter or check back soon.
    </p>
  )}
</div>
