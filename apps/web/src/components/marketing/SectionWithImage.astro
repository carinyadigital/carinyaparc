---
/**
 * Split section with an edge-bleeding photograph on one side and copy on the other
 * (port of sections/section/SectionWithImage.tsx). The `image` slot receives the
 * <Image>; default slot receives the copy.
 */
import { cn } from '@/lib/cn';

interface Props {
  imagePosition?: 'left' | 'right';
  variant?: 'dark' | 'light';
  subtitle?: string;
  title?: string;
  class?: string;
}

const {
  imagePosition = 'left',
  variant = 'light',
  subtitle,
  title,
  class: className,
} = Astro.props;

const isDark = variant === 'dark';
const imageClasses =
  imagePosition === 'left' ? 'md:left-0 md:rounded-r-xl' : 'md:right-0 md:rounded-l-xl';
const contentClasses =
  imagePosition === 'left'
    ? 'md:ml-auto md:w-2/3 md:pl-16 lg:w-1/2 lg:pl-24 xl:pl-32 lg:pr-0'
    : 'md:mr-auto md:w-2/3 md:pr-16 lg:w-1/2 lg:pr-24 xl:pr-32 lg:pl-0';
---

<div
  class={cn('relative', isDark ? 'bg-eucalypt-800' : 'bg-fleece', className)}
  data-image-position={imagePosition}
  data-variant={variant}
>
  <div
    class={cn(
      'relative h-80 overflow-hidden shadow-lg ring-1 ring-line/40 md:absolute md:h-full md:w-1/3 lg:w-1/2',
      imageClasses,
    )}
  >
    <slot name="image" />
  </div>
  <div class="relative mx-auto max-w-7xl py-24 sm:py-32 lg:px-8 lg:py-40">
    <div class={cn('px-6', contentClasses)}>
      {subtitle && (
        <p
          class={cn(
            'text-[13px] font-semibold uppercase tracking-[0.24em]',
            isDark ? 'text-wattle' : 'text-bracken-500',
          )}
        >
          {subtitle}
        </p>
      )}
      {title && (
        <h2
          class={cn(
            'font-heading text-4xl font-normal tracking-tight sm:text-5xl',
            isDark ? 'text-fleece' : 'text-eucalypt-600',
          )}
        >
          {title}
        </h2>
      )}
      <div class={cn('mt-6 text-base/7', isDark ? 'text-inverse-muted' : 'text-charcoal')}>
        <slot />
      </div>
    </div>
  </div>
</div>
