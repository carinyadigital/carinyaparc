---
/** Page header band with optional background photograph. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import { cn } from '@/lib/cn';

interface Props {
  variant?: 'light' | 'dark';
  align?: 'left' | 'center';
  title: string;
  subtitle?: string;
  description?: string;
  backgroundImage?: ImageMetadata;
  backgroundImageAlt?: string;
  class?: string;
}

const {
  variant = 'light',
  align = 'left',
  title,
  subtitle,
  description,
  backgroundImage,
  backgroundImageAlt = 'Header background',
  class: className,
} = Astro.props;

const isDark = variant === 'dark';
const isCenter = align === 'center';
const CLIP =
  'polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)';
---

<div
  class={cn(
    'relative isolate overflow-hidden py-24 sm:py-32',
    !backgroundImage && (isDark ? 'bg-eucalypt-600' : 'bg-paperbark'),
    className,
  )}
>
  {backgroundImage && (
    <div class="absolute inset-0 -z-10 size-full overflow-hidden">
      <Image
        src={backgroundImage}
        alt={backgroundImageAlt}
        widths={[640, 1080, 1600, 2048]}
        sizes="100vw"
        loading={isDark ? 'eager' : 'lazy'}
        class="h-full w-full object-cover object-right brightness-75 md:object-center"
      />
      {isDark && (
        <>
          <div
            aria-hidden="true"
            class="hidden sm:absolute sm:-top-10 sm:right-1/2 sm:-z-10 sm:mr-10 sm:block sm:transform-gpu sm:blur-3xl"
          >
            <div
              style={`clip-path: ${CLIP}`}
              class="aspect-[1097/845] w-[68.5625rem] bg-gradient-to-tr from-eucalypt-500 to-eucalypt-600 opacity-20"
            />
          </div>
          <div
            aria-hidden="true"
            class="absolute -top-52 left-1/2 -z-10 -translate-x-1/2 transform-gpu blur-3xl sm:top-[-28rem] sm:ml-16 sm:translate-x-0"
          >
            <div
              style={`clip-path: ${CLIP}`}
              class="aspect-[1097/845] w-[68.5625rem] bg-gradient-to-tr from-eucalypt-500 to-eucalypt-600 opacity-20"
            />
          </div>
        </>
      )}
    </div>
  )}

  <div class={cn('mx-auto px-6 lg:px-8', isCenter ? 'max-w-2xl text-center' : 'max-w-7xl')}>
    <div class={cn(isCenter ? 'mx-auto text-center' : 'mx-auto lg:mx-0', 'max-w-2xl')}>
      {subtitle && (
        <p class={cn('text-base/7 font-semibold', isDark ? 'text-wattle' : 'text-bracken-500')}>
          {subtitle}
        </p>
      )}
      <h1
        class={cn(
          'mt-2 font-heading text-4xl font-normal tracking-tight sm:text-5xl',
          isDark ? 'text-fleece' : 'text-eucalypt-600',
        )}
      >
        {title}
      </h1>
      {description && (
        <p
          class={cn(
            'mt-8 text-lg font-medium text-pretty sm:text-xl/8',
            isDark ? 'text-eucalypt-100' : 'text-stone',
          )}
        >
          {description}
        </p>
      )}
    </div>
  </div>
</div>
