---
/** Journal teaser band: the newest (or featured) posts in a three-up grid. */
import PostCard from './PostCard.astro';
import { getFeaturedPosts, getPublishedPosts, toPostSummaries } from '@/lib/content/posts';

interface Props {
  title: string;
  subtitle?: string;
  limit?: number;
  featured?: boolean;
  viewAllLink?: string | null;
  eyebrow?: string;
}

const {
  title,
  subtitle,
  limit = 3,
  featured = false,
  viewAllLink = '/blog/',
  eyebrow = 'Life on pasture',
} = Astro.props;

const entries = featured
  ? await getFeaturedPosts(limit)
  : (await getPublishedPosts()).slice(0, limit);
const posts = await toPostSummaries(entries);
---

{posts.length > 0 && (
  <div class="border-t border-line bg-fleece py-16 sm:py-24">
    <div class="mx-auto max-w-[1240px] px-6 lg:px-14">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <p class="text-[13px] font-semibold uppercase tracking-[0.24em] text-bracken-500">
            {eyebrow}
          </p>
          <h2 class="mt-3 font-heading text-4xl font-normal tracking-tight text-balance text-eucalypt-600 sm:text-[40px]">
            {title}
          </h2>
          {subtitle && <p class="mt-2 text-lg/8 text-charcoal">{subtitle}</p>}
        </div>
        {viewAllLink && (
          <a
            href={viewAllLink}
            class="shrink-0 text-[15px] font-semibold text-eucalypt-600 transition-opacity hover:opacity-70"
          >
            View all posts →
          </a>
        )}
      </div>
      <div class="mx-auto mt-12 grid max-w-2xl auto-rows-fr grid-cols-1 gap-7 sm:mt-14 lg:mx-0 lg:max-w-none lg:grid-cols-3">
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    </div>
  </div>
)}
