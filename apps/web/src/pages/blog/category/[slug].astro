---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

import Site from '@/layouts/Site.astro';
import JsonLd from '@/components/ui/JsonLd.astro';
import BlogTopicNav from '@/components/blog/BlogTopicNav.astro';
import JournalIntro from '@/components/blog/JournalIntro.astro';
import PostCard from '@/components/blog/PostCard.astro';
import { getCategoriesWithPosts, toPostSummaries } from '@/lib/content/posts';
import { categoryUrl } from '@/lib/urls';

/** Only categories with at least one published post get an archive. */
export const getStaticPaths = (async () => {
  const categories = await getCategoriesWithPosts();
  return categories.map((category) => ({
    params: { slug: category.id },
    props: { category, categories },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { category, categories } = Astro.props as Props;
const posts = await toPostSummaries(category.posts);
const topics = categories.map((c) => ({ name: c.name, slug: c.id }));
---

<Site
  showNewsletter={false}
  title={`${category.name} - Blog | Carinya Parc`}
  description={`Published stories in ${category.name} from Carinya Parc — regenerative farming, restoration, and life on the property.`}
  path={categoryUrl(category.id)}
>
  <JsonLd />

  <div class="min-h-screen bg-paperbark">
    <JournalIntro
      eyebrow="Blog · Categories"
      title={category.name}
      description={`Published field notes filed under ${category.name}.`}
    />

    <BlogTopicNav categories={topics} activeSlug={category.id} />

    <section class="py-9 pb-[84px]">
      <div class="mx-auto max-w-[1240px] px-6 lg:px-14">
        {posts.length > 0 ? (
          <div class="grid auto-rows-fr grid-cols-1 gap-[30px] lg:grid-cols-3">
            {posts.map((post) => (
              <PostCard post={post} variant="journal" />
            ))}
          </div>
        ) : (
          <p class="py-12 text-center text-charcoal">
            No posts in this category yet. Try another topic or check back soon.
          </p>
        )}
      </div>
    </section>
  </div>
</Site>
