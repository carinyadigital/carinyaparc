---
/**
 * Newsletter subscribe island. Posts JSON to `/api/subscribe/`.
 */
import PrivacyNote from '@/components/newsletter/PrivacyNote.astro';
import { SubscribeForm } from '@/components/newsletter/SubscribeForm';

interface Props {
  showName?: boolean;
  showInterests?: boolean;
}

const { showName = true, showInterests = true } = Astro.props;
---

<SubscribeForm
  client:load
  variant="page"
  showName={showName}
  showInterests={showInterests}
  source="subscribe-page"
>
  <PrivacyNote slot="privacy" class="mt-4 text-center" />
</SubscribeForm>
