---
/**
 * Article header: back link, category kicker, title and author/date line.
 * Ported from `BlogPostHeader` in apps/site features/blog/components/BlogPostArticle.tsx.
 */
interface Props {
  title: string;
  category: string | null | undefined;
  authorName: string;
  date: Date;
}

const { title, category, authorName, date } = Astro.props;

function authorInitials(name: string): string {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase() ?? '')
    .join('');
}

/** Same output as the Next `<Date>` atom (date-fns `LLLL d, yyyy`), e.g. "January 20, 2025". */
const formattedDate = date.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});
const dateTime = date.toISOString();
---

<header class="mx-auto max-w-[720px] px-6 pt-14 text-center lg:px-0">
  <a
    href="/blog/"
    class="text-sm font-semibold text-bracken-500 transition-opacity hover:opacity-70"
  >
    ← Life on pasture
  </a>
  <p class="mt-5 text-[13px] font-semibold uppercase tracking-[0.24em] text-bracken-500">
    {category ?? 'Journal'}
  </p>
  <h1 class="mt-3.5 font-heading text-[40px] font-normal leading-[1.08] text-balance text-eucalypt-600 sm:text-[50px]">
    {title}
  </h1>
  <div class="mt-6 flex items-center justify-center gap-3 text-[14.5px] text-stone">
    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-pill bg-eucalypt-100 font-heading text-base text-eucalypt-700">
      {authorInitials(authorName)}
    </span>
    <span>
      {authorName} · <time datetime={dateTime}>{formattedDate}</time>
    </span>
  </div>
</header>
