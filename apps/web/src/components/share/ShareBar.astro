---
interface Props {
  url: string;
  title: string;
  className?: string;
}

const { url, title, className } = Astro.props;
---

<aside
  data-share-bar
  class:list={[
    'mx-auto mt-10 flex max-w-[720px] flex-col items-center gap-3 border-t border-line px-6 pt-8 sm:flex-row sm:justify-between',
    className,
  ]}
  aria-label="Share this article"
>
  <p class="text-[13px] font-semibold uppercase tracking-[0.24em] text-bracken-500">Share</p>
  <div class="flex flex-wrap items-center justify-center gap-3">
    <button
      type="button"
      data-share-copy
      data-share-url={url}
      data-share-title={title}
      class="inline-flex items-center justify-center gap-2 rounded-pill border-[1.5px] border-eucalypt-600 bg-transparent px-5 py-2.5 text-[13px] font-semibold text-eucalypt-600 hover:bg-eucalypt-50"
      aria-label="Copy link"
    >
      <span data-share-copy-label>Copy link</span>
    </button>
    <button
      type="button"
      data-share-native
      data-share-title={title}
      data-share-url={url}
      hidden
      class="inline-flex items-center justify-center gap-2 rounded-pill bg-transparent px-5 py-2.5 text-[13px] font-semibold text-bracken-500 hover:bg-bracken-50"
      aria-label="Share"
    >
      Share
    </button>
  </div>
  <p data-share-status class="sr-only" aria-live="polite"></p>
</aside>

<script>
  import { bindAllShareBars } from '@/lib/client/share';
  bindAllShareBars();
</script>
