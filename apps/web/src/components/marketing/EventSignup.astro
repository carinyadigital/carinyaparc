---
/**
 * On-site event signup island. Posts JSON to `/api/events/signup/` with eventSlug.
 */
import { EventSignup } from '@/components/islands/EventSignup';

interface Props {
  eventSlug: string;
  eventTitle: string;
  isFull?: boolean;
  class?: string;
}

const { eventSlug, eventTitle, isFull = false, class: className } = Astro.props;
---

<EventSignup
  client:visible
  eventSlug={eventSlug}
  eventTitle={eventTitle}
  isFull={isFull}
  className={className}
/>
