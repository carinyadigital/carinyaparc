---
/**
 * Contact form (static). Same fields, labels, honeypot and copy as the React
 * ContactFormSection; posts to /api/contact/. Phase 4 hydrates via data-form="contact".
 */
import Button from '@/components/ui/Button.astro';
import {
  INPUT_CLASS,
  LABEL_CLASS,
  REQUIRED_MARK_CLASS,
  SELECT_CLASS,
  TEXTAREA_CLASS,
} from './form-classes';

const INQUIRY_OPTIONS = [
  { value: 'partnership', label: 'A grant or partnership' },
  { value: 'volunteer', label: 'Volunteering / planting days' },
  { value: 'tours', label: 'Booking a tour or visit' },
  { value: 'general', label: 'Media, press, or something else' },
] as const;
---

<div>
  <form method="post" action="/api/contact/" data-form="contact" novalidate>
    <div class="grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2">
      <div class="space-y-2">
        <label for="firstName" class={LABEL_CLASS}>
          First name<span class={REQUIRED_MARK_CLASS}>*</span>
        </label>
        <input
          id="firstName"
          name="firstName"
          type="text"
          autocomplete="given-name"
          required
          class={INPUT_CLASS}
        />
      </div>

      <div class="space-y-2">
        <label for="lastName" class={LABEL_CLASS}>
          Last name<span class={REQUIRED_MARK_CLASS}>*</span>
        </label>
        <input
          id="lastName"
          name="lastName"
          type="text"
          autocomplete="family-name"
          required
          class={INPUT_CLASS}
        />
      </div>

      <div class="sm:col-span-2">
        <div class="space-y-2">
          <label for="email" class={LABEL_CLASS}>
            Email<span class={REQUIRED_MARK_CLASS}>*</span>
          </label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            required
            placeholder="jane@example.com"
            class={INPUT_CLASS}
          />
        </div>
      </div>

      <div class="sm:col-span-2">
        <div class="space-y-2">
          <label for="phone" class={LABEL_CLASS}>
            Phone number
          </label>
          <p class="text-sm text-muted-foreground">Optional</p>
          <input
            id="phone"
            name="phone"
            type="tel"
            autocomplete="tel"
            placeholder="+61 4XX XXX XXX"
            class={INPUT_CLASS}
          />
        </div>
      </div>

      <div class="sm:col-span-2">
        <div class="space-y-2">
          <label for="inquiryType" class={LABEL_CLASS}>
            I'm reaching out about<span class={REQUIRED_MARK_CLASS}>*</span>
          </label>
          <select id="inquiryType" name="inquiryType" required class={SELECT_CLASS}>
            <option value="">Select a topic</option>
            {INQUIRY_OPTIONS.map((option) => (
              <option value={option.value}>{option.label}</option>
            ))}
          </select>
        </div>
      </div>

      <div class="sm:col-span-2">
        <div class="space-y-2">
          <label for="message" class={LABEL_CLASS}>
            Message<span class={REQUIRED_MARK_CLASS}>*</span>
          </label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            maxlength="500"
            placeholder="Tell us what you have in mind..."
            class={TEXTAREA_CLASS}
          ></textarea>
        </div>
      </div>

      {/* Honeypot field - hidden from users */}
      <div class="sm:col-span-2" aria-hidden="true" style="display: none">
        <label for="website" class="block text-sm/6 font-semibold text-charcoal">
          Website
        </label>
        <div class="mt-2.5">
          <input
            type="text"
            id="website"
            name="website"
            tabindex="-1"
            autocomplete="off"
            class="block w-full rounded-md bg-white px-3.5 py-2"
          />
        </div>
      </div>

      <div class="mt-6 sm:col-span-2">
        <Button type="submit" class="w-full justify-center">
          Send message →
        </Button>

        <p class="mt-3.5 text-center text-[13px] text-stone">
          We respect your privacy. We'll only use your details to reply. Read our
          <a href="/legal/privacy-policy/" class="font-semibold text-eucalypt-600 hover:opacity-70">
            privacy policy
          </a>
          .
        </p>
      </div>
    </div>
  </form>
</div>
