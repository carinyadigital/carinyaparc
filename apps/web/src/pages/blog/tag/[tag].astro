---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

import Site from '@/layouts/Site.astro';
import JsonLd from '@/components/ui/JsonLd.astro';
import BlogTopicNav from '@/components/blog/BlogTopicNav.astro';
import JournalIntro from '@/components/blog/JournalIntro.astro';
import PostCard from '@/components/blog/PostCard.astro';
import { getCategoriesWithPosts, getTagsWithPosts, toPostSummaries } from '@/lib/content/posts';
import { tagUrl } from '@/lib/urls';

/** Only tags used by at least one published post get an archive. */
export const getStaticPaths = (async () => {
  const [tags, categories] = await Promise.all([getTagsWithPosts(), getCategoriesWithPosts()]);
  return tags.map((tag) => ({
    params: { tag: tag.id },
    props: { tag, categories },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { tag, categories } = Astro.props as Props;
const posts = await toPostSummaries(tag.posts);
const topics = categories.map((c) => ({ name: c.name, slug: c.id }));
---

<Site
  showNewsletter={false}
  title={`${tag.name} - Blog | Carinya Parc`}
  description={`Published stories tagged ${tag.name} from Carinya Parc — regenerative farming, restoration, and life on the property.`}
  path={tagUrl(tag.id)}
>
  <JsonLd />

  <div class="min-h-screen bg-paperbark">
    <JournalIntro
      eyebrow="Blog · Tags"
      title={tag.name}
      description={`Published field notes tagged ${tag.name}.`}
    />

    <BlogTopicNav categories={topics} activeSlug={null} />

    <section class="py-9 pb-[84px]">
      <div class="mx-auto max-w-[1240px] px-6 lg:px-14">
        {posts.length > 0 ? (
          <div class="grid auto-rows-fr grid-cols-1 gap-[30px] lg:grid-cols-3">
            {posts.map((post) => (
              <PostCard post={post} variant="journal" />
            ))}
          </div>
        ) : (
          <p class="py-12 text-center text-charcoal">
            No posts with this tag yet. Try another topic or check back soon.
          </p>
        )}
      </div>
    </section>
  </div>
</Site>
