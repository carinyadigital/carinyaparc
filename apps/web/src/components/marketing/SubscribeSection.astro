---
/**
 * Newsletter subscribe island. Posts JSON to `/api/subscribe/`.
 */
import { SubscribeForm } from '@/components/islands/SubscribeForm';

interface Props {
  showName?: boolean;
  showInterests?: boolean;
}

const { showName = true, showInterests = true } = Astro.props;
---

<SubscribeForm
  client:visible
  showName={showName}
  showInterests={showInterests}
  source="subscribe-page"
/>
