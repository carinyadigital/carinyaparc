---
import Base from './Base.astro';
import Header from '@/components/header/Header.astro';
import Footer from '@/components/footer/Footer.astro';
import NewsletterBand from '@/components/marketing/NewsletterBand.astro';
import ArticleScrollDepth from '@/components/analytics/ArticleScrollDepth.astro';
import { generatePageMetadata, type PageMetadata } from '@/lib/metadata';

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  /** Pixel size of `image`. Omitted pages use the default photograph's real size. */
  imageWidth?: number;
  imageHeight?: number;
  /** Photograph alt for `og:image:alt` and `twitter:image:alt`. */
  imageAlt?: string;
  type?: 'website' | 'article';
  /** ISO 8601. Passed through to `article:published_time` when `type` is `article`. */
  publishedTime?: string;
  /** Author display names. One `article:author` tag each when `type` is `article`. */
  authors?: string[];
  /** Emit `noindex` so the document stays out of search results. */
  noIndex?: boolean;
  /**
   * Skip the canonical link. Used by the not-found page: that document is one
   * static file reused for every unknown URL, so pointing those responses at the
   * error-template URL would tell crawlers that missing paths consolidate onto
   * the template.
   */
  omitCanonical?: boolean;
  overlay?: boolean;
  showFooter?: boolean;
  /**
   * Pre-footer `#stay` newsletter band. Defaults on for marketing pages. Blog
   * routes pass `false` so journal subscribe modules do not stack a second band.
   * Hidden with the footer on the 404 page.
   */
  showNewsletter?: boolean;
  metadata?: PageMetadata;
}

const {
  title,
  description,
  path,
  image,
  imageWidth,
  imageHeight,
  imageAlt,
  type = 'website',
  publishedTime,
  authors,
  noIndex = false,
  omitCanonical = false,
  overlay = false,
  showFooter = true,
  showNewsletter = true,
  metadata: metadataOverride,
} = Astro.props;

const metadata =
  metadataOverride ??
  generatePageMetadata({
    title,
    description,
    path,
    image,
    imageWidth,
    imageHeight,
    imageAlt,
    type,
    publishedTime,
    authors,
    noIndex,
    omitCanonical,
  });
---

<Base metadata={metadata}>
  <Header overlay={overlay} currentPath={Astro.url.pathname} />
  <main class="flex-1">
    <slot />
  </main>
  {showFooter && showNewsletter && <NewsletterBand />}
  {showFooter && <Footer />}
  <ArticleScrollDepth />
</Base>
