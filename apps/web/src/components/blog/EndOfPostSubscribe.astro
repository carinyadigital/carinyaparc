---
/**
 * End-of-article subscribe island. Posts JSON to `/api/subscribe/` with source attribution.
 */
import { EndOfPostSubscribe } from '@/components/islands/EndOfPostSubscribe';

interface Props {
  /** Attribution passed to `/api/subscribe`, e.g. `blog:{slug}`. */
  source: string;
  class?: string;
}

const { source, class: className } = Astro.props;
---

<EndOfPostSubscribe client:visible source={source} className={className} />
