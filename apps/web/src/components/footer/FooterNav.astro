---
interface NavigationItem {
  name: string;
  href: string;
}

interface Props {
  sections: {
    title: string;
    items: NavigationItem[];
  }[];
}

const { sections } = Astro.props;
---

<div class="mt-12 flex flex-col gap-8 sm:flex-row sm:gap-16 xl:mt-0">
  {sections.map((section) => (
    <div>
      <h3 class="text-xs font-semibold uppercase tracking-[0.24em] text-wattle">{section.title}</h3>
      <ul role="list" class="mt-4 space-y-3">
        {section.items.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-sm text-footer-foreground hover:text-wattle transition-opacity"
            >
              {item.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>
