---
import Site from '@/layouts/Site.astro';
import JsonLd from '@/components/ui/JsonLd.astro';
import EventCard from '@/components/marketing/EventCard.astro';
import EventsEmptyState from '@/components/marketing/EventsEmptyState.astro';
import { getUpcomingEvents } from '@/lib/content/events';
import { eventsListingUrl } from '@/lib/urls';

const events = await getUpcomingEvents();
---

<Site
  title="Events - Get Involved | Carinya Parc"
  description="Upcoming planting days, workshops, and volunteer opportunities at Carinya Parc. Join us on the land."
  path={eventsListingUrl()}
>
  <JsonLd />

  <div class="min-h-screen bg-paperbark">
    {/*
      PageIntro with the title/description class overrides the Next page passes
      (the shared PageIntro.astro has no titleClass/descriptionClass props).
    */}
    <section class="pb-12 pt-16">
      <div class="mx-auto max-w-[820px] px-6 text-center lg:px-14">
        <p class="text-[13px] font-semibold uppercase tracking-[0.24em] text-bracken-500">
          Get involved · The Branch, NSW
        </p>
        <h1 class="mx-auto mt-4 max-w-[880px] font-heading text-[40px] font-normal leading-[1.06] text-balance text-eucalypt-600 sm:text-[58px]">
          Come get your hands dirty
        </h1>
        <p class="mx-auto mt-[18px] max-w-[620px] text-[19px] leading-[1.6] text-stone">
          Planting days, workshops, and open days on the farm. Sign up for an upcoming event — or
          subscribe so you're first to hear about the next one.
        </p>
      </div>
    </section>

    <section class="pb-[84px]" aria-label="Upcoming events">
      <div class="mx-auto max-w-[1240px] px-6 lg:px-14">
        {events.length > 0 ? (
          <ul class="grid auto-rows-fr grid-cols-1 gap-[30px] md:grid-cols-2 lg:grid-cols-3">
            {events.map((event) => (
              <li class="flex">
                <EventCard event={event} class="w-full" />
              </li>
            ))}
          </ul>
        ) : (
          <EventsEmptyState />
        )}
      </div>
    </section>
  </div>
</Site>
