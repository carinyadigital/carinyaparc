---
/** Shown on the events listing when nothing is scheduled. */
import Button from '@/components/ui/Button.astro';
---

<div class="mx-auto max-w-xl py-12 text-center">
  <p class="text-[17px] leading-[1.7] text-charcoal">
    No upcoming events just now. Subscribe for invitations to planting days and workshops.
  </p>
  <div class="mt-6">
    <Button href="/subscribe/" variant="bracken" size="sm">
      Subscribe for updates
    </Button>
  </div>
</div>
