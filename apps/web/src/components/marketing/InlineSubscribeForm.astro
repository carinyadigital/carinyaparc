---
/**
 * Single-field email capture used on /regenerate/.
 */
import PrivacyNote from '@/components/newsletter/PrivacyNote.astro';
import { SubscribeForm } from '@/components/newsletter/SubscribeForm';
import Tag from './Tag.astro';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class={className}>
  <SubscribeForm client:visible source="regenerate" variant="compact" submitLabel="Join the list">
    <PrivacyNote slot="privacy" class="mt-4" />
  </SubscribeForm>

  <div class="mt-[22px] flex flex-wrap gap-2.5">
    <Tag tone="eucalypt">Planting days</Tag>
    <Tag tone="kangaroo">Farm tours</Tag>
    <Tag tone="branch">Eco-stays</Tag>
  </div>
</div>
