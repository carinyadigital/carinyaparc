{
  "$schema": "https://v2-10-6.turborepo.dev/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".astro/**", ".vercel/**"],
      "env": [
        "NODE_ENV",
        "MAILERLITE_API_KEY",
        "PUBLIC_SITE_URL",
        "PUBLIC_GTM_ID",
        "PUBLIC_SENTRY_DSN",
        "SENTRY_DSN",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT"
      ]
    },
    "lint": {
      "env": [
        "NODE_ENV",
        "MAILERLITE_API_KEY",
        "PUBLIC_SITE_URL",
        "PUBLIC_GTM_ID",
        "PUBLIC_SENTRY_DSN",
        "SENTRY_DSN",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "NODE_ENV",
        "MAILERLITE_API_KEY",
        "PUBLIC_SITE_URL",
        "PUBLIC_GTM_ID",
        "PUBLIC_SENTRY_DSN",
        "SENTRY_DSN",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/*.tsx",
        "src/**/*.ts",
        "src/**/*.astro",
        "tests/**/*.ts",
        "vercel.json",
        "vitest.config.mjs",
        "vitest.config.ts",
        "vitest.setup.ts"
      ],
      "env": ["NODE_ENV"]
    },
    "clean": {
      "cache": false
    },
    "typecheck": {
      "env": [
        "NODE_ENV",
        "MAILERLITE_API_KEY",
        "PUBLIC_SITE_URL",
        "PUBLIC_GTM_ID",
        "PUBLIC_SENTRY_DSN",
        "SENTRY_DSN",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT"
      ]
    }
  },
  "globalEnv": [
    "NODE_ENV",
    "CI",
    "VERCEL",
    "MAILERLITE_API_KEY",
    "CONTACT_FORM_ENABLE",
    "CONTACT_FORM_RATE_LIMITING",
    "CONTACT_RATE_LIMIT_MAX",
    "CONTACT_RATE_LIMIT_WINDOW_HOURS",
    "EVENT_SIGNUP_RATE_LIMITING",
    "EVENT_SIGNUP_RATE_LIMIT_MAX",
    "EVENT_SIGNUP_RATE_LIMIT_WINDOW_HOURS",
    "RESEND_API_KEY",
    "CONTACT_EMAIL_RECIPIENT",
    "CONTACT_EMAIL_FROM",
    "PUBLIC_SITE_URL",
    "PUBLIC_GTM_ID",
    "PUBLIC_SENTRY_DSN",
    "SENTRY_DSN",
    "SENTRY_AUTH_TOKEN",
    "SENTRY_ORG",
    "SENTRY_PROJECT"
  ]
}
