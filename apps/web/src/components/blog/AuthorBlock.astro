---
/**
 * End-of-article credibility block: photo (or initials), one-line bio, and links to the
 * author and property pages.
 */
const AUTHOR_BIO_HREF = '/about/jonathan/';
const PROPERTY_HREF = '/about/the-property/';

const DEFAULT_BIO = 'Strategic leader turned regenerative farmer, and the founder of Carinya Parc.';

interface Props {
  author: { name: string; imageUrl?: string; bio?: string } | undefined;
}

const { author } = Astro.props;

function authorInitials(name: string): string {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase() ?? '')
    .join('');
}

const authorName = author?.name ?? 'Carinya Parc';
const authorImageUrl = author?.imageUrl;
const bio = author?.bio || DEFAULT_BIO;
const firstName = authorName.split(/\s+/)[0] ?? authorName;
---

<aside
  class="mx-auto mt-12 flex max-w-[720px] gap-5 rounded-lg border border-line bg-fleece p-7 shadow-md"
  aria-labelledby="author-block-name"
>
  <span class="relative flex h-[60px] w-[60px] shrink-0 items-center justify-center overflow-hidden rounded-pill bg-eucalypt-100 font-heading text-[22px] text-eucalypt-700">
    {authorImageUrl ? (
      <img
        src={authorImageUrl}
        alt=""
        width="60"
        height="60"
        loading="lazy"
        class="absolute inset-0 h-full w-full object-cover"
      />
    ) : (
      authorInitials(authorName)
    )}
  </span>
  <div class="min-w-0">
    <p id="author-block-name" class="font-heading text-xl text-bark">
      {authorName}
    </p>
    <p class="mt-1 truncate text-[14.5px] leading-relaxed text-stone">{bio}</p>
    <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-[14px]">
      <a
        href={AUTHOR_BIO_HREF}
        class="font-semibold text-bracken-500 transition-opacity hover:opacity-70"
      >
        About {firstName}
      </a>
      <a
        href={PROPERTY_HREF}
        class="font-semibold text-bracken-500 transition-opacity hover:opacity-70"
      >
        The property
      </a>
    </p>
  </div>
</aside>
