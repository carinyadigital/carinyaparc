{
  "name": "carinya-parc-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": "24.16.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "web:dev": "turbo run dev --filter=web",
    "web:build": "turbo run build --filter=web",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "test": "turbo run test --filter=web",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write --log-level=warn .",
    "format:check": "prettier --check --log-level=warn .",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.1",
    "turbo": "^2.11.7",
    "typescript": "~7.0.2"
  },
  "pnpm": {
    "overrides": {
      "@swc/helpers": "0.5.23",
      "brace-expansion@<1.1.21": "1.1.21",
      "dompurify": ">=3.4.11",
      "esbuild": ">=0.25.0",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "nanoid@<3.3.18": "3.3.18",
      "next@<16.3.8": "16.3.8",
      "path-to-regexp@>=4.0.0 <6.3.0": "6.3.0",
      "postcss": ">=8.5.23",
      "source-map-js@<1.2.2": "1.2.2",
      "toml@<4.2.0": "4.2.0",
      "webpack": "5.111.1"
    }
  }
}
