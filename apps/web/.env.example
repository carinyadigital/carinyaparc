# Carinya Parc Astro app — copy to .env for local development.

NODE_ENV=development

# Canonical site URL used for metadata, JSON-LD, and sitemap.
PUBLIC_SITE_URL=http://localhost:4321

# Google Tag Manager (injected by ConsentGate only after analytics consent).
PUBLIC_GTM_ID=GTM-XXXXXXX

# Sentry — optional in local/CI; omit to skip the integration.
PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=carinya-parc
SENTRY_PROJECT=carinyaparc

# Form endpoints
MAILERLITE_API_KEY=
RESEND_API_KEY=
CONTACT_EMAIL_RECIPIENT=
CONTACT_EMAIL_FROM=noreply@carinyaparc.com.au
CONTACT_FORM_ENABLE=true
CONTACT_FORM_RATE_LIMITING=true
CONTACT_RATE_LIMIT_MAX=3
CONTACT_RATE_LIMIT_WINDOW_HOURS=24
EVENT_SIGNUP_RATE_LIMITING=true
EVENT_SIGNUP_RATE_LIMIT_MAX=5
EVENT_SIGNUP_RATE_LIMIT_WINDOW_HOURS=24
