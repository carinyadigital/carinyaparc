---
import { Image } from 'astro:assets';

import Site from '@/layouts/Site.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';
import JsonLd from '@/components/ui/JsonLd.astro';

import riverValleyAerial from '@/assets/images/river-valley-aerial.jpg';
import alpacasHillPasture from '@/assets/images/alpacas-hill-pasture.jpg';
import propertyRiverAerial from '@/assets/images/property-river-aerial.jpg';
import highlandCattlePaddock from '@/assets/images/highland-cattle-paddock.jpg';

const PHOTO_CLASS = 'max-w-none rounded-2xl bg-line/40 object-cover shadow-md';
---

<Site
  title="Meet Jonno | Carinya Parc"
  description="Jonno looks after Carinya Parc at The Branch, NSW. After twenty years in the boardroom, we are growing 42 hectares of tired grazing land back."
  path="/about/jonathan"
>
  <JsonLd />

  <div class="isolate min-h-screen bg-paperbark">
    {/* Breadcrumb navigation */}
    <div class="mx-auto max-w-[1240px] px-6 pt-8 lg:px-14">
      <Breadcrumb />
    </div>

    {/* Page Header */}
    <div class="pb-16 pt-8 sm:pb-24 sm:pt-12">
      <div class="mx-auto max-w-[1240px] px-6 lg:flex lg:px-14">
        <div class="mx-auto grid max-w-2xl grid-cols-1 gap-x-12 gap-y-16 lg:mx-0 lg:max-w-none lg:min-w-full lg:flex-none lg:gap-y-8">
          <div class="lg:col-end-1 lg:w-full lg:max-w-lg lg:pb-8">
            <p class="mb-3 text-[13px] font-semibold uppercase tracking-[0.24em] text-bracken-500">
              The Branch
            </p>
            <h1 class="max-w-2xl font-heading text-5xl font-normal tracking-tight text-balance text-eucalypt-600 sm:text-7xl lg:col-span-2 xl:col-auto">
              Meet Jonno
            </h1>
            <p class="mt-6 text-xl/8 text-charcoal">
              We look after Carinya Parc at The Branch: 42 hectares of tired grazing land, growing
              back. Jonno traded twenty years of boardrooms for a pair of boots. In early 2024 we
              started on the ground.
            </p>
            <p class="mt-6 text-base/7 text-stone">
              The cooking is older than the farm. Fourteen years ago Jonno was a MasterChef
              finalist, and the first beds here went in outside the kitchen door, before a tree
              line. Come get your hands dirty. There is a place for you here.
            </p>
          </div>
          <div class="flex flex-wrap items-start justify-end gap-6 sm:gap-8 lg:contents">
            <div class="w-0 flex-auto lg:ml-auto lg:w-auto lg:flex-none lg:self-end">
              <Image
                alt="Aerial view of the river valley at Carinya Parc"
                src={riverValleyAerial}
                width={592}
                height={423}
                widths={[592, 1184]}
                sizes="37rem"
                loading="eager"
                fetchpriority="high"
                decoding="sync"
                class={`aspect-[7/5] w-[37rem] ${PHOTO_CLASS}`}
              />
            </div>
            <div class="contents lg:col-span-2 lg:col-end-2 lg:ml-auto lg:flex lg:w-[37rem] lg:items-start lg:justify-end lg:gap-x-8">
              <div class="order-first flex w-64 flex-none justify-end self-end lg:w-auto">
                <Image
                  alt="Alpacas on the hill paddock at Carinya Parc"
                  src={alpacasHillPasture}
                  width={384}
                  height={288}
                  widths={[384, 768]}
                  sizes="24rem"
                  loading="lazy"
                  class={`aspect-[4/3] w-[24rem] flex-none ${PHOTO_CLASS}`}
                />
              </div>
              <div class="flex w-96 flex-auto justify-end lg:w-auto lg:flex-none">
                <Image
                  alt="The Branch River bend below the homestead, seen from above"
                  src={propertyRiverAerial}
                  width={592}
                  height={423}
                  widths={[592, 1184]}
                  sizes="37rem"
                  loading="lazy"
                  class={`aspect-[7/5] w-[37rem] flex-none ${PHOTO_CLASS}`}
                />
              </div>
              <div class="hidden sm:block sm:w-0 sm:flex-auto lg:w-auto lg:flex-none">
                <Image
                  alt="Highland cattle in a paddock, the breed we are bringing to Carinya Parc"
                  src={highlandCattlePaddock}
                  width={384}
                  height={288}
                  widths={[384, 768]}
                  sizes="24rem"
                  loading="lazy"
                  class={`aspect-[4/3] w-[24rem] ${PHOTO_CLASS}`}
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Site>
