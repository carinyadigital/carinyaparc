---
/** "Keep reading" band under an article: up to three related PostCards. */
import type { PostSummary } from '@/lib/content/posts';

import PostCard from './PostCard.astro';

interface Props {
  posts: PostSummary[];
}

const { posts } = Astro.props;
---

{posts.length > 0 && (
  <section class="mt-10 border-t border-line bg-fleece py-20" aria-labelledby="related-posts">
    <div class="mx-auto max-w-[1240px] px-6 lg:px-14">
      <h2 id="related-posts" class="font-heading text-[32px] font-normal text-eucalypt-600">
        Keep reading
      </h2>
      <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-3">
        {posts.map((post) => (
          <PostCard post={post} variant="related" />
        ))}
      </div>
    </div>
  </section>
)}
