---
import { cn } from '@/lib/cn';

export type ImpactStat = { value: string; label: string };

interface Props {
  eyebrow?: string;
  stats?: ImpactStat[];
  class?: string;
}

const DEFAULT_STATS: ImpactStat[] = [
  { value: '42', label: 'hectares under restoration' },
  { value: '30k+', label: 'native trees to plant' },
  { value: '104', label: 'acres of habitat corridor' },
  { value: '400m', label: 'river frontage to restore' },
];

const { eyebrow = 'Progress in the ground', stats = DEFAULT_STATS, class: className } = Astro.props;
---

<section class={cn('bg-eucalypt-800 py-[74px] text-inverse', className)}>
  <div class="mx-auto max-w-[1240px] px-6 lg:px-14">
    <p class="text-center text-[13px] font-semibold uppercase tracking-[0.24em] text-wattle">
      {eyebrow}
    </p>
    <div class="mt-10 grid grid-cols-2 gap-10 lg:grid-cols-4">
      {stats.map((stat) => (
        <div class="text-center">
          <div class="font-heading text-5xl leading-none text-inverse lg:text-[56px]">
            {stat.value}
          </div>
          <div class="mt-2.5 text-[15px] text-inverse-muted">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
